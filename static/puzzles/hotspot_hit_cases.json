[
  {
    "name": "zero tolerance includes the region edge",
    "regions": [{"x": 20, "y": 30, "w": 15, "h": 10}],
    "tolerance": 0,
    "x": 35,
    "y": 40,
    "expected": {"hit": true, "regionIndex": 0}
  },
  {
    "name": "zero tolerance rejects an outside click",
    "regions": [{"x": 20, "y": 30, "w": 15, "h": 10}],
    "tolerance": 0,
    "x": 35.1,
    "y": 40,
    "expected": {"hit": false, "regionIndex": null}
  },
  {
    "name": "tolerance accepts a nearby click",
    "regions": [{"x": 20, "y": 30, "w": 15, "h": 10}],
    "tolerance": 1,
    "x": 35.5,
    "y": 35,
    "expected": {"hit": true, "regionIndex": 0}
  },
  {
    "name": "tolerance clamps padding to image edges",
    "regions": [{"x": 0, "y": 0, "w": 2, "h": 2}],
    "tolerance": 1,
    "x": 0,
    "y": 0,
    "expected": {"hit": true, "regionIndex": 0}
  },
  {
    "name": "overlap chooses the first region",
    "regions": [
      {"x": 10, "y": 10, "w": 20, "h": 20},
      {"x": 20, "y": 20, "w": 20, "h": 20}
    ],
    "tolerance": 0,
    "x": 25,
    "y": 25,
    "expected": {"hit": true, "regionIndex": 0}
  },
  {
    "name": "multiple regions can hit a later region",
    "regions": [
      {"x": 10, "y": 10, "w": 10, "h": 10},
      {"x": 50, "y": 50, "w": 10, "h": 10}
    ],
    "tolerance": 0,
    "x": 55,
    "y": 55,
    "expected": {"hit": true, "regionIndex": 1}
  }
]
